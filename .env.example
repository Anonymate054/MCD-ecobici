# Ecobici CDMX Data Lake — Local Development Environment
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Ecobici GBFS API ─────────────────────────────────────────────────────────
ECOBICI_API_BASE_URL=https://gbfs.mex.lyft.com/gbfs/2.3/mex_mexico_city
ECOBICI_API_KEY=your_ecobici_api_key_here

# ── Institutional Weather API (SMN / REDMET / OH-UNAM) ───────────────────────
WEATHER_API_URL=https://smn.conagua.gob.mx/tools/GUI/webservices/
WEATHER_API_KEY=your_weather_api_key_here

# ── AWS Configuration ────────────────────────────────────────────────────────
# For local development only — use IAM roles in CI/CD and on Lambda.
AWS_REGION=us-east-1
AWS_PROFILE=ecobici-de-01

# ── Resource Names (mirror Terraform outputs) ────────────────────────────────
S3_BUCKET=ecobici-datalake-123456789012
GLUE_DATABASE=ecobici_lake
ATHENA_WORKGROUP=ecobici-workgroup
FIREHOSE_STATION_STATUS_STREAM=ecobici-station-status
FIREHOSE_WEATHER_STREAM=ecobici-weather
GBFS_SECRET_NAME=ecobici/gbfs_api
WEATHER_SECRET_NAME=ecobici/weather_api
SSM_REFRESH_PARAM=/ecobici/last_station_info_refresh

# ── Micro-cleaning Thresholds ─────────────────────────────────────────────────
TEMP_MIN_C=-10
TEMP_MAX_C=50
FORWARD_FILL_MAX_SLOTS=3

# ── Snapshot Retention ────────────────────────────────────────────────────────
SNAPSHOT_DAYS=7
